# R-AI-OS Environment Configuration (Example)
# Copy to .env and adjust variables as needed.

# Log level (error, warn, info, debug, trace)
RUST_LOG=info

# Custom workspace database location (optional, defaults to ~/.config/raios/workspace.db)
# RAIOS_DB_PATH=/home/alaz/.config/raios/workspace.db

# Custom security policy location (optional, defaults to ~/.config/raios/raios-policy.toml or ./raios-policy.toml)
# RAIOS_POLICY_PATH=./raios-policy.toml

# Daemon listening ports (optional, defaults)
# RAIOS_PORT=42071
# RAIOS_WS_PORT=42069
# RAIOS_MCP_PORT=42070

# Cortex embedding cache location (optional)
# FASTEMBED_CACHE_PATH=~/.cache/raios/fastembed
